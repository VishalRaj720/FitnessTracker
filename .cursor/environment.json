{
  "name": "FitSathi",
  "install": "bash .cursor/scripts/cloud-agent-install.sh",
  "terminals": [
    {
      "name": "api",
      "command": "cd backend && uv run uvicorn app.main:app --reload --host 0.0.0.0 --port 8000"
    },
    {
      "name": "web",
      "command": "cd web && npm run dev -- --host 0.0.0.0"
    }
  ],
  "ports": [
    {
      "name": "api",
      "port": 8000
    },
    {
      "name": "web",
      "port": 5173
    }
  ]
}
