# Database. SQLite needs no setup; for Postgres use:
# DATABASE_URL=postgresql+psycopg://fitsathi:fitsathi@localhost:5432/fitsathi
DATABASE_URL=sqlite:///./fitsathi.db

# CHANGE THIS BEFORE DEPLOYING:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=dev-only-secret-change-me-before-deploying-1234567890
JWT_EXPIRE_DAYS=7

# Browser origins allowed to call this API (add your deployed frontend URL here).
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173

# Seed exercises + institutes on startup. Set false in production after the first boot.
AUTO_SEED=true

ENVIRONMENT=development

# Throttles /auth/* to 10 requests/minute. Only disable for load testing.
RATE_LIMIT_ENABLED=true

# AI coach (Google Gemini). Leave GEMINI_API_KEY empty to disable the coach entirely:
# the Coach tab hides itself and workouts fall back to the built-in cues.
# Key: https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL_CUE=gemini-3.5-flash-lite
GEMINI_MODEL_CHAT=gemini-3.5-flash-lite
COMPANION_ENABLED=true

# Timeouts. Gemini's flash models reason before answering, and measured round trips run
# 4-100 s, so the in-workout coach speaks during the rest period rather than mid-set.
COMPANION_CUE_TIMEOUT_S=35
COMPANION_CHAT_TIMEOUT_S=120
